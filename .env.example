# Local PostgreSQL connection; this is also the application's default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/payment_settlement

# OpenAI-compatible LLM provider settings. Do not add real secrets to this file.
LLM_API_KEY=your-openrouter-api-key-here
LLM_MODEL=openai/gpt-oss-20b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional, for another OpenAI-compatible provider:
# LLM_BASE_URL=https://your-provider.example/v1
